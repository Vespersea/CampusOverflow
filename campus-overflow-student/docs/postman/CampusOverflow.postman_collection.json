{
  "info": {
    "_postman_id": "c0-campus-overflow-2026",
    "name": "CampusOverflow API",
    "description": "CampusOverflow 校园问答平台接口集合。先执行「0. 获取 CSRF」与「1. 注册/登录」获取会话（Cookie 自动保存），再调用业务接口。POST/PUT/DELETE 需要 X-XSRF-TOKEN 头（由 Pre-request Script 自动注入）。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "csrfToken", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 从 Cookie 中取 XSRF-TOKEN 并写入集合变量（CSRF 双提交）",
          "const cookies = pm.cookies.get('XSRF-TOKEN');",
          "if (cookies) pm.variables.set('csrfToken', cookies);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "认证 Auth",
      "item": [
        {
          "name": "0. 获取 CSRF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('返回 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/csrf", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "csrf"] }
          },
          "response": []
        },
        {
          "name": "1a. 学生注册",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"20260001\",\n  \"displayName\": \"测试小明\",\n  \"email\": \"ming@campus.edu.cn\",\n  \"password\": \"Campus2026\",\n  \"college\": \"计算机工程学院\",\n  \"className\": \"计科2301\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          },
          "response": []
        },
        {
          "name": "1b. 登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回 200 且携带用户信息', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"20260001\",\n  \"password\": \"Campus2026\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "问答 Q&A",
      "item": [
        {
          "name": "2. 发布问题（POST /api/v1/questions 成功用例）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回 201 且包含问题 id', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.collectionVariables.set('questionId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"跳表和红黑树在工程上如何取舍？\",\n  \"body\": \"课程项目里需要一个有序结构，二者的实现复杂度和并发友好程度差别很大，应该怎么选？\",\n  \"tags\": [\"数据结构\", \"跳表\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/questions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "questions"] }
          },
          "response": []
        },
        {
          "name": "3. 问题列表（分页 + 课程筛选）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回 200 且分页结构完整', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('items').that.is.an('array');",
                  "  pm.expect(body).to.have.property('total').that.is.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions?page=1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. 回答并采纳（声誉 +15 异步结算）",
          "item": [
            {
              "name": "4a. 提交回答",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"body\": \"并发场景优先跳表：插入删除只需局部指针操作，容易做成无锁结构。\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/answers",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "questions", "{{questionId}}", "answers"]
                }
              },
              "response": []
            },
            {
              "name": "4b. 采纳最佳答案",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": ["pm.test('返回 204', () => pm.response.to.have.status(204));"]
                  }
                }
              ],
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"answerId\": {{answerId}}\n}" },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/questions/{{questionId}}/accepted-answer",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "questions", "{{questionId}}", "accepted-answer"]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "发现与声誉 Discovery & Reputation",
      "item": [
        {
          "name": "5. 全文搜索（中文 ngram）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/questions?q=跳表",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "questions"],
              "query": [{ "key": "q", "value": "跳表" }]
            }
          },
          "response": []
        },
        {
          "name": "6. 声誉档案（含徽章与积分）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/reputation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "reputation"]
            }
          },
          "response": []
        },
        {
          "name": "7. 排行榜（周榜）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leaderboard?period=week",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leaderboard"],
              "query": [{ "key": "period", "value": "week" }]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
